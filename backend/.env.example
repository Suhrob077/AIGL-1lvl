# ========== REQUIRED ==========
# Google Gemini API key (free tier available)
# Get your key at: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ========== OPTIONAL ==========
# Server port (default: 8787)
PORT=8787

# Environment mode: development | production (default: development)
NODE_ENV=development

# Comma-separated list of allowed CORS origins
# Example: http://localhost:5500,http://192.168.1.100:5500
# Leave empty to allow all origins (not recommended for production)
ALLOWED_ORIGINS=http://localhost:5500

# Maximum image file upload size in MB (default: 6)
MAX_IMAGE_SIZE_MB=6
RATE_LIMIT_MAX_REQUESTS=20
# Stricter limit specifically for the expensive vision/OCR endpoint
VISION_RATE_LIMIT_MAX_REQUESTS=8

# ---- Upload limits ----
MAX_IMAGE_SIZE_MB=6

# ========== PUSH NOTIFICATIONS (optional — "kunlik norma" reminders) ==========
# Generate your own keypair with: npm run generate-vapid  (inside backend/)
# Never reuse someone else's keys or commit real values to a public repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
