{
  "name": "vocab-app-backend",
  "version": "2.0.0",
  "description": "Secure proxy server for Vision/NLP AI calls (OCR + translation) used by the So'z O'rganish vocabulary app. Powered by Google Gemini. Keeps API keys server-side only.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generate-vapid": "node scripts/generate-vapid-keys.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  }
}
